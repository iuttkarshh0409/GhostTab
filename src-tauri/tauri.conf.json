{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GhostTab",
  "version": "1.0.0",
  "identifier": "com.ghosttab.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GhostTab",
        "width": 1040,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Preserve your context. Resume exactly where you left off.",
    "longDescription": "GhostTab keeps your working context and focused-time history.",
    "copyright": "© GhostTab",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
